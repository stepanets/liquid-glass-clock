<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.08"
            android:text="@string/preview_kicker"
            android:textAllCaps="true"
            android:textColor="@color/preview_text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/preview_text"
            android:textSize="34sp" />

        <include
            android:id="@+id/preview_wide"
            layout="@layout/widget_clock_wide"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:layout_marginTop="28dp" />

        <include
            android:id="@+id/preview_small"
            layout="@layout/widget_clock_small"
            android:layout_width="156dp"
            android:layout_height="156dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/preview_hint"
            android:textColor="@color/preview_text_muted"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
